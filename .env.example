# --- Next.js ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Supabase (only needed by the Karibu VMS dashboard, not by /pay) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- PayHero (M-Pesa) ---
PAYHERO_API_USERNAME=
PAYHERO_API_PASSWORD=
PAYHERO_CHANNEL_ID=
PAYHERO_CALLBACK_URL=https://karibuvms.com/api/payhero/callback

# --- DigiTax eTIMS ---
DIGITAX_API_KEY=
DIGITAX_BRANCH_ID=01
DIGITAX_ITEM_ID=
DIGITAX_TAX_TYPE_CODE=D
DIGITAX_CALLBACK_URL=
DIGITAX_PRODUCTION_ENABLED=false
# When true, /api/payment/initiate performs a REAL PayHero STK Push.
# Leave false for local/demo so no real charges are attempted.
PAYHERO_ENABLED=false
